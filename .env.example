# Local development only. Do not commit real values.
#
# GitHub deployment setup:
# - Put entries under "Environment secrets" in GitHub Environment Secrets.
# - Put entries under "Environment variables" in GitHub Environment Variables.
# - Do not create ENV_PRODUCTION or ENV_STAGING as a single multiline secret.

# ===== Environment variables (not secret) =====
APP_NAME=kalkulator-saham-local
APP_PORT=3000
APP_CPUS=1.0
APP_MEMORY_LIMIT=768m
DB_CPUS=1.0
DB_MEMORY_LIMIT=512m
DB_USER=kalkulator_app
DB_NAME=kalkulator_saham
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=

# Cloudinary (next-cloudinary & Backend Upload API)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# ===== Environment secrets =====
# Use a URL-safe password: letters, numbers, underscore, and hyphen only.
DB_PASSWORD=change-this-local-password
# Generate a unique random value of at least 32 characters for every environment.
SESSION_SECRET=generate-a-random-secret-at-least-32-characters-long
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Or use full URL: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Only required when running `npx prisma db seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
